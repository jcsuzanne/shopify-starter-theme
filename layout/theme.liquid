<!doctype html>
<html
  class='no-js{% if request.design_mode %} shopify-design-mode{% endif %}'
  lang='{{ request.locale.iso_code }}'>
  <head>
    {% render 'meta-favicons' %}
    {% render 'meta-tags', password_mode: false %}
    {% render 'theme-assets' %}
    {% render 'theme-fonts' %}
    {%- liquid
      render 'vite' with 'app.js'
    -%}

    {{ content_for_header }}
  </head>

  <body x-data='DatasApp'>
    <div x-data='CartDrawer' id='master' role='document'>
      {%- render 'cart-drawer' -%}
      {%- render 'ui' -%}
      {% sections 'header-group' %}

      <c-app>
        <c-transitions
          cid='mainTransition'
          log>
          <div
            id='transition-container'
            data-swup-container>
            <c-scroll
              class='transition-main'
              cid='main'>
              <main
                class='main-content'
                tabindex='-1'
                role='main'>
                <container-view>
                  {{ content_for_layout }}
                </container-view>
              </main>
            </c-scroll>
          </div>
        </c-transitions>
      </c-app>
    </div>
    {% render 'theme-datas' %}
  </body>
</html>
