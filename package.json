{
  "name": "jcs-shopify-starter-theme",
  "description": "Starter theme for Shopify using modern dev tools like Vite.js, TailwindCSS and with Pieces.js (for native webcomponents)",
  "author": "JC SUZANNE (https://github.com/jcsuzanne)",
  "version": "1.2.3",
  "type": "module",
  "engines": {
    "node": ">=14.17",
    "npm": ">=6.0"
  },
  "scripts": {
    "dev": "concurrently --passthrough-arguments \"npm run start\" \"npm run shopify {@}\" --",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shopify": "shopify theme dev --live-reload=\"hot-reload\" --notify=/tmp/theme.update --store=jcs-blueprint.myshopify.com --store-password=jcs",
    "logout": "shopify auth logout",
    "deploy": "shopify theme push --store=jcs-blueprint.myshopify.com --only=sections/* --only=snippets/* --only=assets/* --only=layout/* --only=blocks/*",
    "push-assets": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=snippets/* --only=assets/*",
    "push-config": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=config/settings_schema.json",
    "push-locales": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=locales/*",
    "push-sections": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=sections/*",
    "push-templates": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=templates/*",
    "pull-config": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=config/settings_schema.json --only=config/settings_data.json",
    "pull-header-group": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=sections/header-group.json",
    "pull-locales": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=locales/*",
    "pull-templates": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=182753263953 --only=templates/* --only=sections/header-group.json",
    "sync-pull": "yarn pull-config && yarn pull-locales && yarn pull-header-group && yarn pull-templates",
    "clean": "find assets -name 'app.*' \\( -name '*.js' -o -name '*.css' \\) -delete"
  },
  "dependencies": {
    "@swup/fade-theme": "^2.0.1",
    "@swup/parallel-plugin": "^0.4.0",
    "@swup/preload-plugin": "^3.2.11",
    "@swup/scroll-plugin": "^3.3.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "piecesjs": "^0.4.0",
    "swup": "*"
  },
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^2.2.0",
    "@csstools/postcss-global-data": "^3.0.0",
    "@shopify/prettier-plugin-liquid": "1.9.3",
    "@splidejs/splide": "^4.1.4",
    "@swup/fragment-plugin": "^1.1.2",
    "@swup/progress-plugin": "^3.2.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/typography": "0.5.16",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "alpinejs": "^3.14.9",
    "autoprefixer": "^10.4.21",
    "axios": "^1.10.0",
    "concat": "^1.0.3",
    "concurrently": "^9.2.0",
    "cssnano": "7.0.7",
    "currency.js": "^2.0.4",
    "events": "^3.3.0",
    "mobile-detect": "^1.4.5",
    "path": "^0.12.7",
    "postcss": "^8.5.6",
    "postcss-calc": "^10.1.1",
    "postcss-cli": "^11.0.1",
    "postcss-comment": "^2.0.0",
    "postcss-conditionals": "^2.1.0",
    "postcss-custom-media": "^11.0.6",
    "postcss-extend-rule": "^4.0.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-for": "^2.1.1",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-mixins": "^11.0.0",
    "postcss-nested": "^7.0.2",
    "postcss-pxtorem": "^6.1.0",
    "postcss-simple-vars": "^7.0.1",
    "postcss-utilities": "^0.8.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwind-clip-path": "^1.0.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-easing": "^0.2.1",
    "tailwindcss-scoped-preflight": "^3.4.12",
    "vite": "^7.0.2",
    "vite-plugin-page-reload": "^0.2.1",
    "vite-plugin-shopify": "^4.0.1"
  }
}
