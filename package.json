{
  "name": "jcs-shopify-starter-theme",
  "description": "Starter theme for Shopify using modern dev tools like Vite.js, TailwindCSS and with Pieces.js (for native webcomponents)",
  "author": "JC SUZANNE (https://github.com/jcsuzanne)",
  "version": "1.6.3",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0"
  },
  "scripts": {
    "dev": "concurrently --passthrough-arguments \"pnpm start\" \"pnpm shopify {@}\" --",
    "start": "vite",
    "build": "pnpm run clean && vite build",
    "preview": "vite preview",
    "shopify": "shopify theme dev --live-reload=\"hot-reload\" --store=jcs-blueprint.myshopify.com --store-password=jcs",
    "logout": "shopify auth logout",
    "setup-store": "shopify theme push --store=jcs-blueprint.myshopify.com -u",
    "deploy": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=sections/* --only=snippets/* --only=assets/* --only=layout/* --only=blocks/*",
    "push-snippets": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=snippets/* --only=assets/*",
    "push-assets": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=snippets/vite-tag.liquid --only=assets/*",
    "push-config": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=config/settings_schema.json",
    "push-locales": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=locales/*",
    "push-sections": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=sections/*",
    "push-templates": "shopify theme push --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=templates/*",
    "pull-config": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=config/settings_schema.json --only=config/settings_data.json",
    "pull-header-group": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=sections/header-group.json",
    "pull-locales": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=locales/*",
    "pull-templates": "shopify theme pull --store=jcs-blueprint.myshopify.com --theme=188310552913 --only=templates/* --only=sections/header-group.json",
    "sync-pull": "pnpm pull-config && pnpm pull-locales && pnpm pull-header-group && pnpm pull-templates",
    "clean": "find assets -name 'app.*' \\( -name '*.js' -o -name '*.css' \\) -delete",
    "make-tree": "tree -L 4 > .docs/project-tree.txt && find . -maxdepth 4 -type f > .docs/files.txt"
  },
  "dependencies": {
    "@swup/preload-plugin": "^3.2.12",
    "@swup/progress-plugin": "^3.2.0",
    "@swup/scroll-plugin": "^4.0.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "piecesjs": "^0.5.7",
    "swup": "^4.10.0"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.11.3",
    "@tailwindcss/vite": "^4.3.4",
    "alpinejs": "^3.17.5",
    "concurrently": "^10.0.6",
    "currency.js": "^2.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.4",
    "vite": "^8.3.6",
    "vite-plugin-shopify": "^5.0.0"
  }
}
