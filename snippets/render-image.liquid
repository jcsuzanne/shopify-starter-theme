{%- assign loading = loading | default: 'eager' -%}
{% if media.media_type == 'video' %}
  {% render 'render-video',
    media: media,
    klassImg: klassImg,
    videoDetector: videoDetector,
    klassPicture: klassPicture,
    poster: poster,
    fetchpriority: fetchpriority,
    loading: loading
  %}
{% else %}
  <picture
    {% if dataDom != blank %}
      data-dom='{{ dataDom }}'
    {% endif %}
    class='{{ klassPicture }}'>
    {% if setHeight != blank %}
      {{
        media
        | image_url: height: setHeight
        | image_tag:
          widths: '1000, 2000',
          sizes: '100vw',
          class: klassImg,
          loading: loading,
          fetchpriority: fetchpriority,
          width: media.width,
          height: media.height
      }}
    {% elsif setWidth != blank %}
      {{
        media
        | image_url: width: setWidth
        | image_tag:
          widths: '1000, 2000',
          sizes: '100vw',
          class: klassImg,
          loading: loading,
          fetchpriority: fetchpriority,
          width: media.width,
          height: media.height
      }}
    {% else %}
      {{
        media
        | image_url: width: 3000
        | image_tag:
          widths: '400, 768, 1040, 1368, 1710, 1920, 2560, 3000',
          sizes: '100vw',
          class: klassImg,
          loading: loading,
          fetchpriority: fetchpriority,
          width: media.width,
          height: media.height
      }}
    {% endif %}
  </picture>
{% endif %}
