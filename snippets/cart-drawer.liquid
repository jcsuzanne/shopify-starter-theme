{%- liquid
  assign btn_klass = 'transition-opacity duration-300 hover:opacity-40'
  assign label_increase = 'products.product.quantity.increase' | t: product: '%s'
  assign label_decrease = 'products.product.quantity.decrease' | t: product: '%s'
-%}
<cart-drawer
  x-ref='drawer'
  x-effect='$el.inert = !isOpen'
  @keydown.escape.window='isOpen && closeCart()'
  @keydown.tab='trapFocus($event)'
  role='dialog'
  aria-modal='true'
  aria-label='{{ 'sections.cart.title' | t | escape }}'
  tabindex='-1'
  class='lg:right-tiny lg:inset-y-tiny z-cart cart-opened:pointer-events-auto cart-opened:translate-x-0 ease-cubic-in-out pointer-events-none fixed inset-y-0 right-0 w-full max-w-[600px] translate-x-[calc(100%+30px)] bg-white duration-700 lg:w-1/2'
  @cart-update.window='getCart(true)'>
  {% # HEADER %}
  <header class='mx-auto flex h-20 w-full flex-row items-center justify-between border-b border-solid'>
    <p>{{ 'sections.cart.title' | t }}</p>
    <button
      type='button'
      @click='closeCart()'>
      {{ 'accessibility.close' | t }}
    </button>
  </header>

  {% # IF CART EMPTY %}
  <div
    x-show='itemsCount == 0'
    class='flex h-[calc(100%-80px)] flex-col items-center justify-center'>
    <h4>{{ 'sections.cart.empty' | t }}</h4>
    <button
      type='button'
      @click='closeCart()'>
      {{- 'general.continue_shopping' | t -}}
    </button>
  </div>

  {% # CONTENT %}
  <ul
    x-show='itemsCount > 0'
    data-lenis-prevent
    class='block h-[calc(100%-250px)] w-full overflow-x-hidden overflow-y-auto bg-white lg:relative'>
    <template
      x-for='(item, index) in items'
      x-key='item.key'>
      <li class='flex flex-row border-b border-solid p-6'>
        {% # Col IMG %}
        <div class='relative w-[100px]'>
          <img
            :src='item.image'
            :alt='item.product_title'
            class='relative left-0 h-full w-full object-cover'
            width='100'
            height='100'>
        </div>
        {% # Col Infos %}
        <div class='relative flex flex-auto flex-col justify-between pl-6 lg:pl-12'>
          <c-infos class='dom'>
            <div class='flex flex-row items-end justify-between'>
              <h3
                x-text='item.product_title'
                class='text-sm/[18px] text-black lg:text-lg/6'></h3>
              <p
                class='relative top-[1px] hidden text-base/6 text-black lg:block'
                x-html='renderPrice(item.line_price,item)'></p>
              <div class='relative top-[3px] block opacity-50 lg:hidden'>
                {% render 'cart-remove-button' %}
              </div>
              {% # Error %}
              <pdp-error
                x-show='itemsError.find(error => error.id == item.key)'>
                <c-content>
                  <c-shape>
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </c-shape>
                  <span
                    data-dom='message'
                    x-text='itemsError.find(error => error.id == item.key)?.message'></span>
                </c-content>
              </pdp-error>
            </div>
            {% # Check Preoder %}
            <template x-if='item.properties?.Type == "Preorder"'>
              <p>{{ 'sections.cart.preorder' | t }}</p>
            </template>
            {% # Variant Infos %}
            <template x-if='item.variant_title'>
              <p>
                {{ 'sections.cart.variant' | t }} :
                <span x-text='item.variant_title'></span>
              </p>
            </template>
          </c-infos>
          {% # Modifier / Supprimer %}
          <div class='flex flex-row justify-between'>
            <div class='ml-auto flex flex-auto flex-row gap-x-2 lg:gap-x-4'>
              <button
                type='button'
                class='{{ btn_klass }}'
                :aria-label='{{ label_decrease | json | escape }}.replace("%s", item.product_title)'
                x-on:click='deleteOneItem(item);'>
                {{ 'icon-minus.svg' | inline_asset_content }}
              </button>
              <p
                x-text='item.quantity'></p>
              <button
                type='button'
                class='{{ btn_klass }}'
                :aria-label='{{ label_increase | json | escape }}.replace("%s", item.product_title)'
                x-on:click='addOneItem(item);'>
                {{ 'icon-plus.svg' | inline_asset_content }}
              </button>
            </div>
            <div class='u-desktop'>
              {% render 'cart-remove-button' %}
            </div>
            <div class='u-mobile'>
              <p
                x-html='renderPrice(item.line_price,item)'></p>
            </div>
          </div>
        </div>
      </li>
    </template>
  </ul>

  {% # Checkout %}
  <div
    x-show='itemsCount > 0'
    class='absolute inset-x-0 bottom-10'>
    <form
      action='{{ routes.cart_url }}'
      method='post'>
      <button
        type='submit'
        name='checkout'>
        {{ 'sections.cart.checkout' | t }}
      </button>
    </form>
  </div>
</cart-drawer>
{% # Overlay %}
<c-overlay
  @click='closeCart()'
  class='u-popin-overlay cart-opened:opacity-100 cart-opened:pointer-events-auto! z-modal!'></c-overlay>
