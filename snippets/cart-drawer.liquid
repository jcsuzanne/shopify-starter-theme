<cart-drawer
  class='lg:right-popin-p lg:inset-y-popin-p z-cart cart-opened:pointer-events-auto cart-opened:translate-x-0 ease-in-out-cubic pointer-events-none fixed inset-y-0 right-0 w-full max-w-[600px] translate-x-[calc(100%+30px)] bg-white duration-700 lg:w-1/2'
  @cart-update.window='getCart(true)'>
  {% # IF CART EMPTY %}
  <template x-if='itemsCount == 0'>
    <div class='absolute inset-0 z-20 bg-white'>
      <div class='mx-auto flex h-20 w-full flex-row items-center justify-end border-b border-solid'>
        <button @click='closeCart()'>Close</button>
      </div>
      <div class='flex h-[calc(100%-70px)] flex-col items-center justify-center lg:h-[calc(100%-80px)]'>
        <h4>Empty</h4>
        <button
          @click='closeCart()'>
          {{- 'general.continue_shopping' | t -}}
        </button>
      </div>
    </div>
  </template>
  {% # HEADER %}
  <header class='mx-auto flex h-20 w-full flex-row items-center justify-between border-b border-solid'>
    <p>Cart</p>
    <button @click='closeCart()'>close</button>
  </header>

  {% # CONTENT %}
  <ul
    data-lenis-prevent
    class='block h-[calc(100%-250px)] w-full overflow-y-auto overflow-x-hidden bg-white lg:relative'>
    <template
      x-for='(item, index) in items'
      x-key='index'>
      <li class='flex flex-row border-b border-solid p-6'>
        {% # Col IMG %}
        <div class='relative w-[100px]'>
          <img
            :src='item.image'
            class='relative left-0 h-full w-full object-cover'
            width='100'
            height='100'>
        </div>
        {% # Col Infos %}
        <div class='relative flex flex-auto flex-col justify-between pl-6 lg:pl-12'>
          <infos class='util-dom relative'>
            <div class='flex flex-row items-end justify-between'>
              <h3
                x-html='item.product_title'
                class='font-suisse-bk text-sm/[18px] text-black lg:text-lg/6'></h3>
              <p
                class='font-suisse-bk relative top-[1px] hidden text-base/6 text-black lg:block'
                x-html='renderPrice(item.line_price,item)'></p>
              <div class='relative top-[3px] block opacity-50 lg:hidden'>
                {% render 'cart-remove-button' %}
              </div>
              {% # Error %}
              <pdp-error
                x-show='itemsError.find(error => error.id == item.key)'>
                <c-content>
                  <c-shape>
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </c-shape>
                  <span
                    data-dom='message'
                    x-html='itemsError.find(error => error.id == item.key)?.message'></span>
                </c-content>
              </pdp-error>
            </div>
            {% # Check Preoder %}
            <template x-if='item.properties.Type == "Preorder"'>
              <p>Preorder</p>
            </template>
            {% # Variant Infos %}
            <div>
              <p>
                Variant Title :
                <span x-text='item.variant_title'></span>
              </p>
            </div>
          </infos>
          {% # Modifier / Supprimer %}
          <div class='flex flex-row justify-between'>
            <div class='ml-auto flex flex-auto flex-row gap-x-2 lg:gap-x-4'>
              {%- assign btn_klass = 'transitions-color duration-300 hover:opacity-40' -%}
              <button
                class='{{ btn_klass }}'
                x-on:click='deleteOneItem(item);'>
                {{ 'icon-minus.svg' | inline_asset_content }}
              </button>
              <p
                x-text='item.quantity'></p>
              <button
                class='{{ btn_klass }}'
                x-on:click='addOneItem(item);'>
                {{ 'icon-plus.svg' | inline_asset_content }}
              </button>
            </div>
            <div class='u-desktop'>
              {% render 'cart-remove-button' %}
            </div>
            <div class='u-mobile'>
              <p
                x-html='renderPrice(item.line_price,item)'></p>
            </div>
          </div>
        </div>
      </li>
    </template>
  </ul>

  {% # Checkout %}
  <div class='absolute inset-x-0 bottom-10'>
    <form
      action='{{ routes.cart_url }}'
      method='post'>
      <button type='submit' name='checkout'>Buy</button>
    </form>
  </div>
</cart-drawer>
{% # Overlay %}
<overlay
  @click='closeCart()'
  class='u-popin-overlay cart-opened:opacity-100 cart-opened:pointer-events-auto! z-modal!'></overlay>
