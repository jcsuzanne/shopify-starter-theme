{% if video != blank %}
  {% render 'render-image',
    media: video,
    klassPicture: klassPicture,
    klassImg: klassImg,
    lazy: lazy,
    fetchpriority: fetchpriority,
    videoDetector: videoDetector,
    parallax: parallax,
    poster: visual,
    setWidth: setWidth,
    setHeight: setHeight
  %}
{% endif %}
{% if visual != blank and video == blank %}
  {% render 'render-image',
    media: visual,
    klassPicture: klassPicture,
    klassImg: klassImg,
    lazy: lazy,
    fetchpriority: fetchpriority,
    videoDetector: videoDetector,
    parallax: parallax,
    setWidth: setWidth,
    setHeight: setHeight
  %}
{% endif %}
