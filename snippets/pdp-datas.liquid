{%- liquid
  assign selected_product = product.selected_or_first_available_variant
  assign current_image = selected_product.featured_image | image_url: width: 3000
  assign price_to_display = selected_product.price | money | replace: '.', ' '
  assign compared_price_to_display = selected_product.compare_at_price | money | replace: '.', ' '
-%}
{%- capture key_variant -%}
  {%- for option in selected_product.options -%}{{- option.id -}}{%- unless forloop.last -%}_{%- endunless -%}{%- endfor -%}
{%- endcapture -%}
{%- capture variant_description -%}{{ selected_product.metafields.main.description }}{%- endcapture -%}
{%- comment -%} Initial state of ProductDatas: every value goes through `| json` {%- endcomment -%}
{%- capture model -%}
  {
    "variantId": {{ selected_product.id | json }},
    "currentImageId": {{ selected_product.featured_image.id | json }},
    "currentImage": {{ current_image | json }},
    "price": {{ selected_product.price | json }},
    "available": {{ selected_product.available | json }},
    "priceToDisplay": {{ price_to_display | json }},
    "comparedPriceToDisplay": {{ compared_price_to_display | json }},
    "variantTitle": {{ selected_product.title | json }},
    "variantDescription": {{ variant_description | json }},
    "inventoryPolicy": {{ selected_product.inventory_policy | json }},
    "inventoryDisplay": {{ selected_product.inventory_quantity | json }},
    "inventoryManagement": {{ selected_product.inventory_management | default: '' | json }},
    "recipientName": "",
    "recipientEmail": "",
    "recipientMessage": "",
    "recipientControlFlag": false,
    "keyVariant": {{ key_variant | json }},
    "option1": {{ selected_product.option1 | json }},
    "option2": {{ selected_product.option2 | json }},
    "option3": {{ selected_product.option3 | json }},
    "option1ID": {{ selected_product.options[0].id | json }},
    "option2ID": {{ selected_product.options[1].id | json }},
    "option3ID": {{ selected_product.options[2].id | json }},
    "variantQuantity": "1",
    "optionColorName": {{ selected_product.options[1].name | json }}
  }
{%- endcapture -%}
<div
  id='product-view'
  x-data='ProductDatas'
  @option-changed.window='generateKeyVariant(true)'
  @pdp-panels-opened.window='togglePanel("opened")'
  @pdp-panels-closed.window='togglePanel("closed")'
  data-model='{{ model | strip | escape }}'>
  <pdp-addtocart
    class='z-10 flex flex-col lg:flex-row'>
    {% render 'pdp-form', product: product, mode: mode %}
  </pdp-addtocart>
</div>
{% render 'pdp-json' %}
{% render 'product-json-schema' %}
