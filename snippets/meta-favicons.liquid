<link
  rel='icon'
  type='image/png'
  href='{{ 'favicon-96x96.png' | asset_url }}'
  sizes='96x96'>
<link
  rel='icon'
  type='image/svg+xml'
  href='{{ 'favicon.svg' | asset_url }}'>
<link rel='shortcut icon' href='{{ 'favicon.ico' | asset_url }}'>
<link
  rel='apple-touch-icon'
  sizes='180x180'
  href='{{ 'apple-touch-icon.png' | asset_url }}'>
<meta name='apple-mobile-web-app-title' content='{{ shop.name }}'>
<link rel='manifest' href='{{ 'site.webmanifest' | asset_url }}'>
